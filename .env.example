PORT=3000
NODE_ENV=development

# Local SQLite fallback:
# DATABASE_PATH=./database/winabwangu.db

# Render / hosted PostgreSQL (recommended for free or low-cost plans):
# DATABASE_URL=postgresql://username:password@host:5432/database_name
# DATABASE_SSL=false

# Optional test browser, e.g. msedge or chrome; otherwise bundled Chromium is used.
# PLAYWRIGHT_CHANNEL=msedge
